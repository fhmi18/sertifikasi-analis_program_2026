<!DOCTYPE html>
<html lang="id">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %> - Inventory Management System</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
        <style>
            .sidebar {
                transition: all 0.3s ease;
            }

            .sidebar.collapsed {
                margin-left: -250px;
            }
        </style>
        <script src="/js/auth.js"></script>
    </head>

    <body class="bg-gray-50">
        <!-- Navigation Bar -->
        <nav class="bg-white shadow-md sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <button id="toggleSidebar" class="text-gray-600 hover:text-gray-900">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                    <h1 class="text-2xl font-bold text-blue-600">📦 IMS</h1>
                </div>
                <div class="flex items-center gap-4">
                    <span class="text-gray-700">Selamat datang</span>
                    <button id="logoutBtn"
                        class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition">
                        Logout
                    </button>
                </div>
            </div>
        </nav>

        <div class="flex min-h-screen">
            <!-- Sidebar -->
            <aside id="sidebar" class="w-64 bg-gray-900 text-white p-6 sidebar">
                <ul class="space-y-4">
                    <li>
                        <a href="/" class="block px-4 py-2 rounded-lg hover:bg-gray-800 transition">
                            🏠 Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/items" class="block px-4 py-2 rounded-lg hover:bg-gray-800 transition">
                            📦 Barang
                        </a>
                    </li>
                    <li>
                        <a href="/loans" class="block px-4 py-2 rounded-lg hover:bg-gray-800 transition">
                            📋 Peminjaman
                        </a>
                    </li>
                    <li>
                        <a href="/reports" class="block px-4 py-2 rounded-lg hover:bg-gray-800 transition">
                            📊 Laporan
                        </a>
                    </li>
                    <li id="userMenuLink">
                        <a href="/users" class="block px-4 py-2 rounded-lg hover:bg-gray-800 transition">
                            👥 User
                        </a>
                    </li>
                </ul>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 p-8">
                <%- body %>
            </main>
        </div>

        <!-- Toast Notification -->
        <div id="toast" class="fixed bottom-4 right-4 bg-white rounded-lg shadow-lg p-4 hidden">
            <p id="toastMessage"></p>
        </div>

        <script>
            // Hide Users menu for non-ADMIN roles
            function initializeAuthUI() {
                const userMenuLink = document.getElementById('userMenuLink');
                if (userMenuLink && !canManageUsers()) {
                    userMenuLink.style.display = 'none';
                }
            }

            // Initialize auth UI on page load
            document.addEventListener('DOMContentLoaded', initializeAuthUI);

            // Sidebar toggle
            document.getElementById('toggleSidebar').addEventListener('click', function () {
                document.getElementById('sidebar').classList.toggle('collapsed');
            });

            // Logout
            document.getElementById('logoutBtn').addEventListener('click', function () {
                fetch('/api/auth/logout', {
                        method: 'POST'
                    })
                    .then(() => window.location.href = '/login')
                    .catch(err => console.error(err));
            });

            // Toast notification function
            function showToast(message, type = 'success') {
                const toast = document.getElementById('toast');
                const toastMessage = document.getElementById('toastMessage');
                toastMessage.textContent = message;
                toast.classList.remove('hidden');
                toast.className = `fixed bottom-4 right-4 rounded-lg shadow-lg p-4 text-white ${
        type === 'success' ? 'bg-green-500' : 'bg-red-500'
      }`;
                setTimeout(() => toast.classList.add('hidden'), 3000);
            }
        </script>
    </body>

</html>