<!DOCTYPE html>
<html lang="id">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Laporan & Analytics - IMS</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    </head>

    <body class="bg-gray-50">
        <!-- Navigation Bar -->
        <nav class="bg-white shadow-md sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <h1 class="text-2xl font-bold text-blue-600">📦 IMS</h1>
                </div>
                <button onclick="logout()" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg">
                    Logout
                </button>
            </div>
        </nav>

        <div class="flex">
            <!-- Sidebar -->
            <aside class="w-64 bg-gray-900 text-white p-6 min-h-screen">
                <ul class="space-y-4">
                    <li><a href="/dashboard" class="block px-4 py-2 rounded-lg hover:bg-gray-800">🏠 Dashboard</a></li>
                    <li><a href="/items" class="block px-4 py-2 rounded-lg hover:bg-gray-800">📦 Barang</a></li>
                    <li><a href="/loans" class="block px-4 py-2 rounded-lg hover:bg-gray-800">📋 Peminjaman</a></li>
                    <li><a href="/reports" class="block px-4 py-2 rounded-lg bg-blue-600">📊 Laporan</a></li>
                    <li><a href="/users" class="block px-4 py-2 rounded-lg hover:bg-gray-800">👥 User</a></li>
                </ul>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 p-8">

                <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
                    <!-- Header -->
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h1 class="text-3xl font-bold text-gray-900">Laporan & Analytics</h1>
                            <p class="text-gray-600 mt-2">Analisis data inventaris dan peminjaman</p>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="exportReport('inventory')"
                                class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg flex items-center gap-2">
                                <i class="fas fa-download"></i> Export
                            </button>
                        </div>
                    </div>

                    <!-- Tabs -->
                    <div class="flex gap-2 mb-6 border-b border-gray-200">
                        <button onclick="switchTab('inventory')" id="tabInventory"
                            class="px-4 py-3 text-gray-700 font-medium border-b-2 border-blue-600">Inventaris</button>
                        <button onclick="switchTab('loans')" id="tabLoans"
                            class="px-4 py-3 text-gray-700 font-medium border-b-2 border-transparent hover:border-gray-300">Peminjaman</button>
                        <button onclick="switchTab('activity')" id="tabActivity"
                            class="px-4 py-3 text-gray-700 font-medium border-b-2 border-transparent hover:border-gray-300">Aktivitas</button>
                    </div>

                    <!-- Inventory Report -->
                    <div id="inventoryTab" class="space-y-6">
                        <!-- Summary Cards -->
                        <div class="grid grid-cols-4 gap-4">
                            <div class="bg-white rounded-lg shadow p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm">Total Barang</p>
                                        <p class="text-3xl font-bold text-gray-900" id="totalItems">0</p>
                                    </div>
                                    <i class="fas fa-boxes text-4xl text-blue-600 opacity-20"></i>
                                </div>
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm">Tersedia</p>
                                        <p class="text-3xl font-bold text-green-600" id="availableItems">0</p>
                                    </div>
                                    <i class="fas fa-check-circle text-4xl text-green-600 opacity-20"></i>
                                </div>
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm">Dipinjam</p>
                                        <p class="text-3xl font-bold text-yellow-600" id="borrowedItems">0</p>
                                    </div>
                                    <i class="fas fa-share-alt text-4xl text-yellow-600 opacity-20"></i>
                                </div>
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm">Rusak</p>
                                        <p class="text-3xl font-bold text-red-600" id="damagedItems">0</p>
                                    </div>
                                    <i class="fas fa-exclamation-circle text-4xl text-red-600 opacity-20"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Charts -->
                        <div class="grid grid-cols-2 gap-6">
                            <div class="bg-white rounded-lg shadow p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Barang per Kategori</h3>
                                <div class="relative h-64">
                                    <canvas id="categoryChart"></canvas>
                                </div>
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Status Barang</h3>
                                <div class="relative h-64">
                                    <canvas id="statusChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loans Report -->
                    <div id="loansTab" class="hidden space-y-6">
                        <div class="grid grid-cols-4 gap-4">
                            <div class="bg-white rounded-lg shadow p-6">
                                <p class="text-gray-600 text-sm">Total Peminjaman</p>
                                <p class="text-3xl font-bold text-gray-900" id="totalLoans">0</p>
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <p class="text-gray-600 text-sm">Pending</p>
                                <p class="text-3xl font-bold text-yellow-600" id="pendingLoans">0</p>
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <p class="text-gray-600 text-sm">Disetujui</p>
                                <p class="text-3xl font-bold text-green-600" id="approvedLoans">0</p>
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <p class="text-gray-600 text-sm">Dikembalikan</p>
                                <p class="text-3xl font-bold text-blue-600" id="returnedLoans">0</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-6">
                            <div class="bg-white rounded-lg shadow p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Status Peminjaman</h3>
                                <div class="relative h-64">
                                    <canvas id="loanStatusChart"></canvas>
                                </div>
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Top 5 Barang Dipinjam</h3>
                                <div class="relative h-64">
                                    <canvas id="topItemsChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Activity Report -->
                    <div id="activityTab" class="hidden">
                        <div class="bg-white rounded-lg shadow p-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Aktivitas Pengguna (30 Hari Terakhir)
                            </h3>
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-100">
                                        <tr>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                Waktu
                                            </th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                User
                                            </th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                Aktivitas</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                IP
                                                Address</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200" id="activityTableBody">
                                        <tr>
                                            <td colspan="4" class="px-6 py-4 text-center text-gray-500">
                                                <i class="fas fa-spinner fa-spin"></i> Loading...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    let charts = {};
                    let currentTab = 'inventory';

                    async function loadInventoryReport() {
                        try {
                            const response = await fetch('/api/reports/inventory', {
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                }
                            });

                            if (!response.ok) throw new Error('Gagal memuat laporan');

                            const data = await response.json();
                            const report = data.data;

                            // Update summary cards
                            document.getElementById('totalItems').textContent = report.totalItems || 0;
                            document.getElementById('availableItems').textContent = (report.summary && report
                                .summary
                                .byStatus && report.summary.byStatus.TERSEDIA) || 0;
                            document.getElementById('borrowedItems').textContent = (report.summary && report.summary
                                .byStatus && report.summary.byStatus.DIPINJAM) || 0;
                            document.getElementById('damagedItems').textContent = (report.summary && report.summary
                                .byStatus && report.summary.byStatus.MAINTENANCE) || 0;

                            // Update charts
                            updateCategoryChart((report.summary && report.summary.byCategory) || {});
                            updateStatusChart((report.summary && report.summary.byStatus) || {});
                        } catch (error) {
                            console.error('Error:', error);
                            showError('Gagal memuat laporan inventaris');
                        }
                    }

                    async function loadLoansReport() {
                        try {
                            const response = await fetch('/api/reports/loans', {
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                }
                            });

                            if (!response.ok) throw new Error('Gagal memuat laporan');

                            const data = await response.json();
                            const report = data.data;

                            document.getElementById('totalLoans').textContent = report.totalLoans || 0;
                            document.getElementById('pendingLoans').textContent = (report.summary && report.summary
                                .byStatus && report.summary.byStatus.PENDING) || 0;
                            document.getElementById('approvedLoans').textContent = (report.summary && report.summary
                                .byStatus && report.summary.byStatus.APPROVED) || 0;
                            document.getElementById('returnedLoans').textContent = (report.summary && report.summary
                                .byStatus && report.summary.byStatus.RETURNED) || 0;

                            updateLoanStatusChart((report.summary && report.summary.byStatus) || {});
                            updateTopItemsChart((report.summary && report.summary.byItem) || {});
                        } catch (error) {
                            console.error('Error:', error);
                            showError('Gagal memuat laporan peminjaman');
                        }
                    }

                    async function loadActivityReport() {
                        try {
                            const response = await fetch('/api/reports/activities?limit=50', {
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                }
                            });

                            if (!response.ok) throw new Error('Gagal memuat laporan');

                            const data = await response.json();
                            const logs = data.data.logs || [];

                            const tbody = document.getElementById('activityTableBody');
                            tbody.innerHTML = logs.slice(0, 50).map(log => `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm text-gray-600">${formatDate(log.createdAt)}</td>
                        <td class="px-6 py-4 text-sm font-medium text-gray-900">${log.user?.username || 'System'}</td>
                        <td class="px-6 py-4 text-sm text-gray-900">${log.activity}</td>
                        <td class="px-6 py-4 text-sm text-gray-600">${log.ipAddress || '-'}</td>
                    </tr>
                `).join('');

                            if (logs.length === 0) {
                                tbody.innerHTML =
                                    '<tr><td colspan="4" class="px-6 py-4 text-center text-gray-500">Tidak ada aktivitas</td></tr>';
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            showError('Gagal memuat laporan aktivitas');
                        }
                    }

                    function updateCategoryChart(categories) {
                        const ctx = document.getElementById('categoryChart').getContext('2d');
                        if (charts.category) charts.category.destroy();

                        charts.category = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: Object.keys(categories),
                                datasets: [{
                                    label: 'Jumlah',
                                    data: Object.values(categories),
                                    backgroundColor: ['#3b82f6', '#10b981', '#f59e0b']
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false
                            }
                        });
                    }

                    function updateStatusChart(statuses) {
                        const ctx = document.getElementById('statusChart').getContext('2d');
                        if (charts.status) charts.status.destroy();

                        charts.status = new Chart(ctx, {
                            type: 'doughnut',
                            data: {
                                labels: Object.keys(statuses),
                                datasets: [{
                                    data: Object.values(statuses),
                                    backgroundColor: ['#10b981', '#f59e0b', '#ef4444']
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false
                            }
                        });
                    }

                    function updateLoanStatusChart(statuses) {
                        const ctx = document.getElementById('loanStatusChart').getContext('2d');
                        if (charts.loanStatus) charts.loanStatus.destroy();

                        charts.loanStatus = new Chart(ctx, {
                            type: 'doughnut',
                            data: {
                                labels: Object.keys(statuses),
                                datasets: [{
                                    data: Object.values(statuses),
                                    backgroundColor: ['#f59e0b', '#10b981', '#ef4444', '#8b5cf6']
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false
                            }
                        });
                    }

                    function updateTopItemsChart(items) {
                        const ctx = document.getElementById('topItemsChart').getContext('2d');
                        if (charts.topItems) charts.topItems.destroy();

                        const topItems = Object.entries(items).sort((a, b) => b[1] - a[1]).slice(0, 5);

                        charts.topItems = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: topItems.map(([name]) => name),
                                datasets: [{
                                    label: 'Dipinjam',
                                    data: topItems.map(([, count]) => count),
                                    backgroundColor: '#3b82f6'
                                }]
                            },
                            options: {
                                indexAxis: 'y',
                                responsive: true,
                                maintainAspectRatio: false
                            }
                        });
                    }

                    function switchTab(tab) {
                        currentTab = tab;
                        document.getElementById('inventoryTab').classList.add('hidden');
                        document.getElementById('loansTab').classList.add('hidden');
                        document.getElementById('activityTab').classList.add('hidden');

                        document.getElementById('tabInventory').classList.remove('border-blue-600');
                        document.getElementById('tabLoans').classList.remove('border-blue-600');
                        document.getElementById('tabActivity').classList.remove('border-blue-600');

                        if (tab === 'inventory') {
                            document.getElementById('inventoryTab').classList.remove('hidden');
                            document.getElementById('tabInventory').classList.add('border-blue-600');
                            loadInventoryReport();
                        } else if (tab === 'loans') {
                            document.getElementById('loansTab').classList.remove('hidden');
                            document.getElementById('tabLoans').classList.add('border-blue-600');
                            loadLoansReport();
                        } else if (tab === 'activity') {
                            document.getElementById('activityTab').classList.remove('hidden');
                            document.getElementById('tabActivity').classList.add('border-blue-600');
                            loadActivityReport();
                        }
                    }

                    async function exportReport(type) {
                        try {
                            const response = await fetch(`/api/reports/export?type=${type}`, {
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                }
                            });

                            if (!response.ok) throw new Error('Gagal export');

                            const blob = await response.blob();
                            const url = window.URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = `report-${type}-${new Date().toISOString().split('T')[0]}.csv`;
                            document.body.appendChild(a);
                            a.click();
                            window.URL.revokeObjectURL(url);
                            document.body.removeChild(a);

                            showSuccess('Laporan berhasil di-export');
                        } catch (error) {
                            showError('Gagal mengekspor laporan');
                        }
                    }

                    function formatDate(dateString) {
                        if (!dateString) return 'N/A';
                        return new Date(dateString).toLocaleDateString('id-ID', {
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                    }

                    function showSuccess(message) {
                        const toast = document.createElement('div');
                        toast.className = 'fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg';
                        toast.textContent = message;
                        document.body.appendChild(toast);
                        setTimeout(() => toast.remove(), 3000);
                    }

                    function showError(message) {
                        const toast = document.createElement('div');
                        toast.className = 'fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg';
                        toast.textContent = message;
                        document.body.appendChild(toast);
                        setTimeout(() => toast.remove(), 3000);
                    }

                    loadInventoryReport();
                </script>
            </main>
        </div>
        <script>
            async function logout() {
                try {
                    await fetch('/api/auth/logout', {
                        method: 'POST'
                    });
                    localStorage.removeItem('token');
                    window.location.href = '/login';
                } catch (error) {
                    console.error('Error:', error);
                }
            }
        </script>
    </body>

</html>