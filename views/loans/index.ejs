<!DOCTYPE html>
<html lang="id">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Manajemen Peminjaman - IMS</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    </head>

    <body class="bg-gray-50">
        <!-- Navigation Bar -->
        <nav class="bg-white shadow-md sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <h1 class="text-2xl font-bold text-blue-600">📦 IMS</h1>
                </div>
                <button onclick="logout()" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg">
                    Logout
                </button>
            </div>
        </nav>

        <div class="flex">
            <!-- Sidebar -->
            <aside class="w-64 bg-gray-900 text-white p-6 min-h-screen">
                <ul class="space-y-4">
                    <li><a href="/dashboard" class="block px-4 py-2 rounded-lg hover:bg-gray-800">🏠 Dashboard</a></li>
                    <li><a href="/items" class="block px-4 py-2 rounded-lg hover:bg-gray-800">📦 Barang</a></li>
                    <li><a href="/loans" class="block px-4 py-2 rounded-lg bg-blue-600">📋 Peminjaman</a></li>
                    <li><a href="/reports" class="block px-4 py-2 rounded-lg hover:bg-gray-800">📊 Laporan</a></li>
                    <li><a href="/users" class="block px-4 py-2 rounded-lg hover:bg-gray-800">👥 User</a></li>
                </ul>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 p-8">

                <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
                    <!-- Header -->
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h1 class="text-3xl font-bold text-gray-900">Manajemen Peminjaman</h1>
                            <p class="text-gray-600 mt-2">Kelola request dan approval peminjaman barang</p>
                        </div>
                        <button onclick="window.location.href='/loans/new'"
                            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg flex items-center gap-2">
                            <i class="fas fa-plus"></i> Request Peminjaman
                        </button>
                    </div>

                    <!-- Tabs -->
                    <div class="flex gap-2 mb-6 border-b border-gray-200">
                        <button onclick="switchTab('all')" id="tabAll"
                            class="px-4 py-3 text-gray-700 font-medium border-b-2 border-blue-600">Semua</button>
                        <button onclick="switchTab('pending')" id="tabPending"
                            class="px-4 py-3 text-gray-700 font-medium border-b-2 border-transparent hover:border-gray-300">Pending</button>
                        <button onclick="switchTab('approved')" id="tabApproved"
                            class="px-4 py-3 text-gray-700 font-medium border-b-2 border-transparent hover:border-gray-300">Disetujui</button>
                        <button onclick="switchTab('returned')" id="tabReturned"
                            class="px-4 py-3 text-gray-700 font-medium border-b-2 border-transparent hover:border-gray-300">Dikembalikan</button>
                    </div>

                    <!-- Loans Table -->
                    <div class="bg-white rounded-lg shadow overflow-hidden">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-100">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Peminjam
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Barang
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Qty</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tanggal
                                        Pinjam
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Jatuh
                                        Tempo</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Aksi
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200" id="loansTableBody">
                                <tr>
                                    <td colspan="7" class="px-6 py-4 text-center text-gray-500">
                                        <i class="fas fa-spinner fa-spin"></i> Loading...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="mt-6 flex justify-between items-center">
                        <div id="paginationInfo" class="text-gray-600"></div>
                        <div class="flex gap-2" id="paginationButtons"></div>
                    </div>
                </div>

                <!-- Return Modal -->
                <div id="returnModal"
                    class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                    <div class="bg-white rounded-lg p-6 w-96">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Kembalikan Barang</h3>
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Kondisi Barang</label>
                            <select id="returnCondition"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">Pilih Kondisi</option>
                                <option value="BAIK">Baik</option>
                                <option value="RUSAK">Rusak</option>
                            </select>
                        </div>
                        <div class="flex gap-3">
                            <button onclick="closeReturnModal()"
                                class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 px-4 py-2 rounded-lg">Batal</button>
                            <button onclick="submitReturn()"
                                class="flex-1 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg">Kembalikan</button>
                        </div>
                    </div>
                </div>

                <script>
                    let currentTab = 'all';
                    let currentPage = 1;
                    let loanToReturn = null;

                    async function loadLoans(page = 1) {
                        try {
                            let url = '/api/loans?page=' + page + '&limit=10';
                            if (currentTab === 'pending') url = '/api/loans/pending?page=' + page + '&limit=10';
                            else if (currentTab === 'approved') url = '/api/loans?page=' + page +
                                '&limit=10&status=APPROVED';
                            else if (currentTab === 'returned') url = '/api/loans?page=' + page +
                                '&limit=10&status=RETURNED';

                            const response = await fetch(url, {
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                }
                            });

                            if (!response.ok) throw new Error('Failed to load loans');

                            const data = await response.json();
                            const responseData = data.data || {};
                            const loans = Array.isArray(responseData) ? responseData : (responseData.loans ||
                                responseData
                                .data || []);
                            const pagination = responseData.pagination || data.pagination || null;

                            currentPage = page;
                            renderLoans(loans);
                            if (pagination) renderPagination(pagination);
                        } catch (error) {
                            console.error('Error:', error);
                            showError('Gagal memuat data peminjaman');
                            const tbody = document.getElementById('loansTableBody');
                            if (tbody) tbody.innerHTML =
                                `<tr><td colspan="7" class="px-6 py-4 text-center text-red-500">Gagal memuat data: ${error.message}</td></tr>`;
                        }
                    }

                    function renderLoans(loans) {
                        const tbody = document.getElementById('loansTableBody');

                        if (loans.length === 0) {
                            tbody.innerHTML =
                                '<tr><td colspan="7" class="px-6 py-4 text-center text-gray-500">Tidak ada data peminjaman</td></tr>';
                            return;
                        }

                        tbody.innerHTML = loans.map(loan => `
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 text-sm font-medium text-gray-900">${loan.user?.fullName || 'N/A'}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${loan.item?.itemName || 'N/A'}</td>
                    <td class="px-6 py-4 text-sm font-semibold">${loan.quantity}</td>
                    <td class="px-6 py-4 text-sm text-gray-600">${formatDate(loan.loanDate)}</td>
                    <td class="px-6 py-4 text-sm text-gray-600">${formatDate(loan.dueDate)}</td>
                    <td class="px-6 py-4 text-sm">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold ${getStatusColor(loan.status)}">
                            ${loan.status}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-sm flex gap-2">
                        <a href="/loans/${loan.id}" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-eye"></i>
                        </a>
                        ${loan.status === 'PENDING' ? `
                            <button onclick="approveLoan(${loan.id})" class="text-green-600 hover:text-green-800" title="Setujui">
                                <i class="fas fa-check"></i>
                            </button>
                            <button onclick="rejectLoan(${loan.id})" class="text-red-600 hover:text-red-800" title="Tolak">
                                <i class="fas fa-times"></i>
                            </button>
                        ` : ''}
                        ${loan.status === 'APPROVED' ? `
                            <button onclick="openReturnModal(${loan.id})" class="text-purple-600 hover:text-purple-800" title="Kembalikan">
                                <i class="fas fa-undo"></i>
                            </button>
                        ` : ''}
                    </td>
                </tr>
            `).join('');
                    }

                    function renderPagination(pagination) {
                        const info = document.getElementById('paginationInfo');
                        const buttons = document.getElementById('paginationButtons');

                        info.textContent =
                            `Menampilkan ${(pagination.page - 1) * pagination.limit + 1} - ${Math.min(pagination.page * pagination.limit, pagination.total)} dari ${pagination.total} peminjaman`;

                        buttons.innerHTML = '';
                        if (pagination.page > 1) {
                            buttons.innerHTML +=
                                `<button onclick="loadLoans(${pagination.page - 1})" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">Sebelumnya</button>`;
                        }

                        for (let i = 1; i <= pagination.pages; i++) {
                            buttons.innerHTML +=
                                `<button onclick="loadLoans(${i})" class="px-4 py-2 border border-gray-300 rounded-lg ${i === pagination.page ? 'bg-blue-600 text-white' : 'hover:bg-gray-50'}">${i}</button>`;
                        }

                        if (pagination.page < pagination.pages) {
                            buttons.innerHTML +=
                                `<button onclick="loadLoans(${pagination.page + 1})" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">Selanjutnya</button>`;
                        }
                    }

                    function switchTab(tab) {
                        currentTab = tab;
                        document.querySelectorAll('[id^="tab"]').forEach(el => {
                            el.classList.remove('border-blue-600');
                            el.classList.add('border-transparent');
                        });
                        document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.remove(
                            'border-transparent');
                        document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add(
                            'border-blue-600');
                        loadLoans(1);
                    }

                    function getStatusColor(status) {
                        const colors = {
                            'PENDING': 'bg-yellow-100 text-yellow-800',
                            'APPROVED': 'bg-green-100 text-green-800',
                            'REJECTED': 'bg-red-100 text-red-800',
                            'RETURNED': 'bg-gray-100 text-gray-800'
                        };
                        return colors[status] || 'bg-gray-100 text-gray-800';
                    }

                    async function approveLoan(id) {
                        if (!confirm('Setujui peminjaman ini?')) return;

                        try {
                            const response = await fetch(`/api/loans/${id}/approve`, {
                                method: 'POST',
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                }
                            });

                            if (!response.ok) throw new Error('Gagal menyetujui');
                            showSuccess('Peminjaman disetujui');
                            loadLoans(currentPage);
                        } catch (error) {
                            showError(error.message);
                        }
                    }

                    async function rejectLoan(id) {
                        if (!confirm('Tolak peminjaman ini?')) return;

                        try {
                            const response = await fetch(`/api/loans/${id}/reject`, {
                                method: 'POST',
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                }
                            });

                            if (!response.ok) throw new Error('Gagal menolak');
                            showSuccess('Peminjaman ditolak');
                            loadLoans(currentPage);
                        } catch (error) {
                            showError(error.message);
                        }
                    }

                    function openReturnModal(id) {
                        loanToReturn = id;
                        document.getElementById('returnModal').classList.remove('hidden');
                    }

                    function closeReturnModal() {
                        document.getElementById('returnModal').classList.add('hidden');
                        loanToReturn = null;
                    }

                    async function submitReturn() {
                        const condition = document.getElementById('returnCondition').value;
                        if (!condition) {
                            showError('Pilih kondisi barang');
                            return;
                        }

                        try {
                            const response = await fetch(`/api/loans/${loanToReturn}/return`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                },
                                body: JSON.stringify({
                                    condition
                                })
                            });

                            if (!response.ok) throw new Error('Gagal mengembalikan barang');
                            showSuccess('Barang berhasil dikembalikan');
                            closeReturnModal();
                            loadLoans(currentPage);
                        } catch (error) {
                            showError(error.message);
                        }
                    }

                    function formatDate(dateString) {
                        if (!dateString) return 'N/A';
                        return new Date(dateString).toLocaleDateString('id-ID', {
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit'
                        });
                    }

                    function showSuccess(message) {
                        const toast = document.createElement('div');
                        toast.className = 'fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg';
                        toast.textContent = message;
                        document.body.appendChild(toast);
                        setTimeout(() => toast.remove(), 3000);
                    }

                    function showError(message) {
                        const toast = document.createElement('div');
                        toast.className = 'fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg';
                        toast.textContent = message;
                        document.body.appendChild(toast);
                        setTimeout(() => toast.remove(), 3000);
                    }

                    loadLoans(1);
                </script>
            </main>
        </div>
        <script>
            async function logout() {
                try {
                    await fetch('/api/auth/logout', {
                        method: 'POST'
                    });
                    localStorage.removeItem('token');
                    window.location.href = '/login';
                } catch (error) {
                    console.error('Error:', error);
                }
            }
        </script>
    </body>

</html>