<!DOCTYPE html>
<html lang="id">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Detail Barang - IMS</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    </head>

    <body class="bg-gray-50">
        <!-- Navigation Bar -->
        <nav class="bg-white shadow-md sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <h1 class="text-2xl font-bold text-blue-600">📦 IMS</h1>
                </div>
                <button onclick="logout()" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg">
                    Logout
                </button>
            </div>
        </nav>

        <div class="flex">
            <!-- Sidebar -->
            <aside class="w-64 bg-gray-900 text-white p-6 min-h-screen">
                <ul class="space-y-4">
                    <li><a href="/dashboard" class="block px-4 py-2 rounded-lg hover:bg-gray-800">🏠 Dashboard</a></li>
                    <li><a href="/items" class="block px-4 py-2 rounded-lg bg-blue-600">📦 Barang</a></li>
                    <li><a href="/loans" class="block px-4 py-2 rounded-lg hover:bg-gray-800">📋 Peminjaman</a></li>
                    <li><a href="/reports" class="block px-4 py-2 rounded-lg hover:bg-gray-800">📊 Laporan</a></li>
                    <li><a href="/users" class="block px-4 py-2 rounded-lg hover:bg-gray-800">👥 User</a></li>
                </ul>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 p-8">
                <div class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
                    <div class="bg-white rounded-lg shadow p-8">
                        <div class="flex justify-between items-start mb-8 pb-6 border-b">
                            <div>
                                <h1 class="text-3xl font-bold text-gray-900">Detail Barang</h1>
                                <p class="text-gray-600 mt-2" id="itemTitle">Loading...</p>
                            </div>
                            <span id="statusBadge"
                                class="px-4 py-2 rounded-full text-sm font-semibold">Loading...</span>
                        </div>

                        <!-- Loading State -->
                        <div id="loading" class="text-center py-12">
                            <i class="fas fa-spinner fa-spin text-3xl text-blue-600 mb-4"></i>
                            <p class="text-gray-600">Memuat detail barang...</p>
                        </div>

                        <!-- Content -->
                        <div id="content" class="hidden">
                            <div class="grid grid-cols-2 gap-8 mb-8">
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Informasi Utama</h3>
                                    <div class="space-y-3">
                                        <p><span class="font-medium text-gray-700">Kode Barang:</span> <span
                                                id="itemCode">-</span></p>
                                        <p><span class="font-medium text-gray-700">Nama Barang:</span> <span
                                                id="itemName">-</span></p>
                                        <p><span class="font-medium text-gray-700">Kategori:</span> <span
                                                id="itemCategory">-</span></p>
                                        <p><span class="font-medium text-gray-700">Lokasi:</span> <span
                                                id="location">-</span></p>
                                    </div>
                                </div>
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Status & Kondisi</h3>
                                    <div class="space-y-3">
                                        <p><span class="font-medium text-gray-700">Kuantitas Tersedia:</span> <span
                                                id="quantity">-</span></p>
                                        <p><span class="font-medium text-gray-700">Kondisi:</span> <span
                                                id="conditionBadge"
                                                class="px-2 py-1 rounded-full text-xs font-semibold">-</span></p>
                                        <p><span class="font-medium text-gray-700">Harga:</span> <span
                                                id="price">-</span></p>
                                        <p><span class="font-medium text-gray-700">Tgl Pembelian:</span> <span
                                                id="purchaseDate">-</span></p>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-8">
                                <h3 class="text-lg font-semibold text-gray-900 mb-2">Deskripsi</h3>
                                <p class="text-gray-700 bg-gray-50 p-4 rounded-lg border border-gray-200 min-h-[4rem]"
                                    id="description">-</p>
                            </div>

                            <div class="flex gap-3">
                                <button onclick="window.history.back()"
                                    class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 px-4 py-2 rounded-lg font-medium">Kembali</button>
                                <button id="editBtn"
                                    class="flex-1 bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded-lg font-medium">Edit
                                    Barang</button>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    const itemId = window.location.pathname.split('/')[2];

                    async function loadItem() {
                        try {
                            const response = await fetch(`/api/items/${itemId}`, {
                                headers: {
                                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                                }
                            });

                            if (!response.ok) throw new Error('Gagal memuat detail barang');

                            const data = await response.json();
                            const item = data.data;

                            document.getElementById('itemTitle').textContent = item.itemCode + ' - ' + item
                            .itemName;

                            const statusBadge = document.getElementById('statusBadge');
                            statusBadge.textContent = item.status;
                            statusBadge.className =
                                `px-4 py-2 rounded-full text-sm font-semibold ${getStatusColor(item.status)}`;

                            document.getElementById('itemCode').textContent = item.itemCode;
                            document.getElementById('itemName').textContent = item.itemName;
                            document.getElementById('itemCategory').textContent = item.category;
                            document.getElementById('location').textContent = item.location;
                            document.getElementById('quantity').textContent = item.quantity;

                            const conditionBadge = document.getElementById('conditionBadge');
                            conditionBadge.textContent = item.condition;
                            conditionBadge.className =
                                `px-2 py-1 rounded-full text-xs font-semibold ${item.condition === 'BAIK' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`;

                            document.getElementById('price').textContent = item.price ? 'Rp ' + parseFloat(item
                                .price).toLocaleString('id-ID') : '-';
                            document.getElementById('purchaseDate').textContent = formatDate(item.purchaseDate);
                            document.getElementById('description').textContent = item.description ||
                                'Tidak ada deskripsi';

                            document.getElementById('editBtn').onclick = () => window.location.href =
                                `/items/${item.id}/edit`;

                            document.getElementById('loading').classList.add('hidden');
                            document.getElementById('content').classList.remove('hidden');
                        } catch (error) {
                            console.error('Error:', error);
                            alert('Gagal memuat detail barang');
                        }
                    }

                    function getStatusColor(status) {
                        const colors = {
                            'TERSEDIA': 'bg-green-100 text-green-800',
                            'DIPINJAM': 'bg-yellow-100 text-yellow-800',
                            'MAINTENANCE': 'bg-red-100 text-red-800'
                        };
                        return colors[status] || 'bg-gray-100 text-gray-800';
                    }

                    function formatDate(dateString) {
                        if (!dateString) return '-';
                        return new Date(dateString).toLocaleDateString('id-ID', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                    }

                    async function logout() {
                        try {
                            await fetch('/api/auth/logout', {
                                method: 'POST'
                            });
                            localStorage.removeItem('token');
                            window.location.href = '/login';
                        } catch (error) {
                            console.error('Error:', error);
                        }
                    }

                    loadItem();
                </script>
            </main>
        </div>
    </body>

</html>