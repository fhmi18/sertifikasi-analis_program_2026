// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// Enum for user roles
enum UserRole {
    STAFF
    PETUGAS_INVENTARIS
    ADMIN
}

// Enum for item condition
enum ItemCondition {
    BAIK
    RUSAK
}

// Enum for item status
enum ItemStatus {
    TERSEDIA
    DIPINJAM
    MAINTENANCE
}

// Enum for loan status
enum LoanStatus {
    PENDING
    APPROVED
    REJECTED
    RETURNED
}

// Users table
model User {
    id        Int      @id @default(autoincrement())
    username  String   @unique @db.VarChar(100)
    email     String   @unique @db.VarChar(100)
    password  String   @db.VarChar(255)
    fullName  String   @db.VarChar(255)
    role      UserRole @default(STAFF)
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    loans       Loan[]
    approvedLoa Loan[] @relation("Approver")
    logs        Log[]

    @@index([username])
    @@index([email])
}

// Items table
model Item {
    id           Int           @id @default(autoincrement())
    itemCode     String        @unique @db.VarChar(50)
    itemName     String        @db.VarChar(255)
    category     String        @db.VarChar(100)
    quantity     Int           @default(0)
    condition    ItemCondition @default(BAIK)
    status       ItemStatus    @default(TERSEDIA)
    location     String        @db.VarChar(255)
    description  String?       @db.Text
    purchaseDate DateTime?
    price        Decimal       @default(0) @db.Decimal(10, 2)
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt

    // Relations
    loans Loan[]

    @@index([itemCode])
    @@index([category])
    @@index([status])
}

// Loans table
model Loan {
    id              Int        @id @default(autoincrement())
    userId          Int
    itemId          Int
    loanDate        DateTime   @default(now())
    dueDate         DateTime
    returnDate      DateTime?
    quantity        Int        @default(1)
    status          LoanStatus @default(PENDING)
    notes           String?    @db.Text
    approvedAt      DateTime?
    approvedBy      Int?
    rejectionReason String?    @db.Text
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt

    // Relations
    user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    item     Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
    approver User? @relation("Approver", fields: [approvedBy], references: [id])

    @@index([userId])
    @@index([itemId])
    @@index([status])
}

// Activity Logs table
model Log {
    id        Int      @id @default(autoincrement())
    userId    Int?
    activity  String   @db.VarChar(255)
    details   String?  @db.Text
    ipAddress String?  @db.VarChar(50)
    userAgent String?  @db.Text
    createdAt DateTime @default(now())

    // Relations
    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([userId])
    @@index([createdAt])
}
